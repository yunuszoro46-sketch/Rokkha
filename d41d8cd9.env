# =====================================================================
# Rokkha — every environment setting of the whole project, in one place.
# PRIVATE: holds real secrets. Git-ignored; never commit, paste or share.
# Each tool still reads its own file — copy the block you need there:
#   Backend      -> Backend/.env               (also the Render dashboard)
#   Frontend     -> Frontend/.env.local        (production value: Vercel dashboard)
#   Browser tests-> Frontend/.env.e2e.local
#   CI           -> GitHub repo Settings > Secrets and variables > Actions
# =====================================================================

# ---------- BACKEND (FastAPI, app/core/config.py) ----------
# Production MongoDB Atlas (the same value is on Render and in the GitHub secret MONGODB_URI).
MONGODB_URI=mongodb+srv://abirnowshed_db_user:ICGGYJO597LqL0DS@climate-shield-cluster.dzymwxu.mongodb.net/
MONGODB_DATABASE=climate_shield
# Comma list as JSON. Render must include the portal: ["https://rokkha-app.vercel.app"]
CORS_ORIGINS='["https://rokkha-app.vercel.app","http://localhost:3000","http://localhost:3100"]'
# true on the public server (Render): only accounts, help requests and admin routes may write.
PUBLIC_READ_ONLY=true
DEBUG=false
PROJECT_NAME="Climate Shield"
API_V1_PREFIX=/api/v1
# Open-Meteo call budget for ingestion runs.
INGESTION_MAX_CALLS_PER_HOUR=4000
INGESTION_MAX_CALLS_PER_DAY=8000

# Local preview backend (uvicorn --port 8001) uses the local Docker database instead:
# MONGODB_URI=mongodb://127.0.0.1:27018
# MONGODB_DATABASE=rokkha_preview
# CORS_ORIGINS='["http://localhost:3100"]'
# PUBLIC_READ_ONLY=false

# Backend tests (pytest) always use a local database, never Atlas:
TEST_MONGODB_URI=mongodb://127.0.0.1:27018

# ---------- FRONTEND (Next.js) ----------
# Live site value (Vercel); for the local preview use http://localhost:8001/api/v1
NEXT_PUBLIC_API_URL=https://rokkha-backend.onrender.com/api/v1
# Demo logins shown as hover hints on the LOCAL login page only. Never set these on Vercel.
NEXT_PUBLIC_DEMO_RESCUER="e2e-rescuer-a@rokkha.test|egFw6JV4R-4Y82LlcjvqDtnX"
NEXT_PUBLIC_DEMO_ADMIN="e2e-admin@rokkha.test|7D_69DgH6w9nzA2aFxfKy4CI"

