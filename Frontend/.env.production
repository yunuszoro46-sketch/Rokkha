# Used by `next build` (and so by Vercel): the hosted backend on Render.
# This is a public address, not a secret. Secrets never go in this file.
# Local development (`npm run dev`) ignores it and uses http://localhost:8000.
# A NEXT_PUBLIC_API_URL set in the Vercel dashboard overrides this value.
NEXT_PUBLIC_API_URL=https://rokkha-backend.onrender.com/api/v1
